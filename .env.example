# ==============================================================================
# PARCELMAP ENVIRONMENT CONFIGURATION
# ==============================================================================

# Port configuration
PORT=3001
VITE_PORT=3000

# Optional High-Definition Satellite/Aerial Provider Tokens
# Note: Default configuration uses Esri World Imagery (global, high-definition, no token required).
# If you wish to use a custom commercial satellite provider or Mapbox Satellite, set the token below:
VITE_MAP_SATELLITE_TOKEN=
VITE_MAPBOX_TOKEN=

# Map Configuration
VITE_DEFAULT_MAP_STYLE=light
